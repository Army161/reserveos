# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# IMPORTANT: in production this MUST be a login role granted `reserveos_app`,
# never a superuser or the schema owner. Both bypass row-level security, which
# would silently disable tenant isolation (migration 005) and the append-only
# grants (002). Create one with:
#
#   CREATE ROLE reserveos_login LOGIN PASSWORD '...';
#   GRANT reserveos_app TO reserveos_login;
#
# Migrations are the exception and are run as the owner.
DATABASE_URL=postgres://reserveos_login:changeme@localhost:5432/reserveos

# Used by the database test suites, which need owner rights to reset tables.
# When unreachable, those suites skip rather than fail, so `npm test` still
# works without Docker.
TEST_DATABASE_URL=postgres://postgres:dev@localhost:55432/reserveos

# --- Kaleido ----------------------------------------------------------------
# Populated during the provisioning spike (build-v1.md section 4). Until then
# the application runs against FakeKaleidoClient. Setting KALEIDO_API_URL
# switches main.ts to KaleidoRestClient (src/kaleido/rest.ts) — read that
# file's header before doing so: submitAnchor, getAnchorReceipt, and the value
# half of getTokenSupply are grounded in FireFly/evmconnect's own source, but
# PMS policy evaluation and getTokenSupply's block context are not yet
# confirmed against a live Kaleido environment.
KALEIDO_API_URL=
KALEIDO_API_KEY=
KALEIDO_ENVIRONMENT_ID=
KALEIDO_TMS_URL=
KALEIDO_KMS_KEY_ID=
KALEIDO_POLICY_MANAGER_URL=
EVIDENCE_ANCHOR_ADDRESS=

# Optional; all default sensibly (see rest.ts). Set only if the spike finds a
# live environment that needs something other than the default.
# KALEIDO_AUTH_SCHEME=basic          # or "bearer"
# KALEIDO_NAMESPACE=default          # FireFly namespace for anchor operations
# KALEIDO_CONTRACT_API_NAME=evidenceanchor
# KALEIDO_TETHER_URL=                # unset = getLatestTetherProof() returns null

# --- Ingestion --------------------------------------------------------------
# Directory watched by the statement worker when a custodian is configured for
# local-file delivery rather than SFTP.
STATEMENT_INBOX_DIR=./.data/inbox

# --- Custodian SFTP ---------------------------------------------------------
# Per-custodian in production (stored in custodians.connector_config, with the
# secret held by reference). These are for a single-feed local run.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=
SFTP_DIRECTORY=inbox

# Required, no opt-out. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` on the
# server, or `ssh-keyscan -t ed25519 <host> | ssh-keygen -lf -`. ssh2 accepts ANY
# host key when no fingerprint is pinned, and the payload here is a bank's
# complete reserve position.
SFTP_HOST_KEY_FINGERPRINT=
